<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Ad-hoc builds only, never shipped. An ad-hoc signature carries no Team
       ID, so library validation refuses to load Sparkle.framework:
       "mapping process and mapped file have different Team IDs".
       A Developer ID build does not need this. -->
  <key>com.apple.security.cs.disable-library-validation</key><true/>
</dict>
</plist>
