<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Deliberately empty. The app is not sandboxed (it writes
       ~/.claude/settings.json), and it needs no hardened-runtime exceptions:
       Sparkle.framework carries the same Team ID, so library validation
       passes as-is. Adding exceptions here would weaken a shipped build. -->
</dict>
</plist>
